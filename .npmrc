# 默认使用高可用国内开源镜像（已全量实时同步 @yss-ui 开源生态）
registry=https://registry.npmmirror.com/

# 针对 @yss-ui 作用域显式指定 npmmirror 高速源
@yss-ui:registry=https://registry.npmmirror.com/

# 二进制下载镜像加速
sass_binary_site=https://npmmirror.com/mirrors/node-sass
node_gyp_binary_host_mirror=https://npmmirror.com/mirrors/node-gyp/

# 关闭跨源认证透传
always-auth=false
