{
  // ==================== 编辑器基础配置 ====================
  "editor.formatOnSave": true, // 保存时自动格式化
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit" // 保存时自动修复 ESLint 错误
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode", // 默认使用 Prettier 格式化
  "editor.tabSize": 2, // Tab 大小为 2 个空格
  "editor.insertSpaces": true, // 使用空格而不是 Tab

  // ==================== 文件类型特定配置 ====================
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[less]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },

  // ==================== ESLint 配置 ====================
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],

  // ==================== Prettier 配置 ====================
  "prettier.enable": true,
  "prettier.requireConfig": true, // 需要配置文件
  "prettier.useEditorConfig": false, // 不使用 .editorconfig

  // ==================== Vue 相关配置 ====================
  "vetur.validation.template": false, // 禁用 Vetur 模板验证（使用 Volar）
  "vetur.validation.script": false,
  "vetur.validation.style": false,

  // ==================== 文件关联配置 ====================
  "files.associations": {
    "*.vue": "vue",
    "*.cjs": "javascript",
    "*.mjs": "javascript"
  },

  // ==================== 文件换行符配置 ====================
  "files.eol": "\n", // 统一使用 LF 换行符

  // ==================== TypeScript 配置 ====================
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ==================== 其他优化配置 ====================
  "editor.quickSuggestions": {
    "strings": true // 在字符串中启用快速建议
  },
  "editor.suggest.snippetsPreventQuickSuggestions": false,

  // ==================== 保存时的额外操作 ====================
  "files.trimTrailingWhitespace": true, // 保存时删除行尾空格
  "files.insertFinalNewline": true, // 保存时在文件末尾插入新行
  "files.trimFinalNewlines": true // 保存时删除文件末尾多余空行
}
